# ─── Upload ảnh ──────────────────────────────────────────────────────────
# Thư mục lưu file tải lên từ máy (tương đối so với thư mục gốc backend)
UPLOAD_DIR=storage/uploads
# Kích thước tối đa cho 1 file (byte) — 5MB
UPLOAD_MAX_SIZE=5242880
# Đường dẫn public để đọc lại file đã tải lên
UPLOAD_PUBLIC_PATH=/api/uploads
