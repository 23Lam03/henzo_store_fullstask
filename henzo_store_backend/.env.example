# ═══════════════════════════════════════════════════════════════════════════════
#  HENZO STORE — BIẾN MÔI TRƯỜNG BACKEND
# ═══════════════════════════════════════════════════════════════════════════════
#
#  Copy file này thành `.env` để chạy local:
#      cp .env.example .env
#
#  ⚠️  KHÔNG commit file `.env` thật (đã nằm trong .gitignore).
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://leduclam2303_db_user:V8F2mTS5xOT2caYl@minx.kn4gmcz.mongodb.net/henzo_store?appName=Minx

# ─── Server ────────────────────────────────────────────────────────────────────
# Local: 4000. Trên Render, `PORT` được hệ thống gán tự động — luôn để
# server đọc `process.env.PORT` (đã xử lý trong `server.mjs`).
PORT=4000
NODE_ENV=development

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=thay-bang-chuoi-bi-mat-dai-hon-16-ky-tu
JWT_REFRESH_SECRET=thay-bang-chuoi-bi-mat-khac-dai-hon-16-ky-tu
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── Cookie ────────────────────────────────────────────────────────────────────
COOKIE_NAME=henzo_refresh_token
COOKIE_SECURE=false
# SameSite:
#   Lax  — local dev (frontend & API cùng localhost)
#   None — production tách domain (Render). Bắt buộc kèm COOKIE_SECURE=true.
COOKIE_SAME_SITE=Lax
# COOKIE_DOMAIN=.henzo.vn

# ─── CORS (phân tách bằng dấu phẩy) ────────────────────────────────────────────
# Local: http://localhost:5173,http://localhost:3000
# Production: https://henzo-store.onrender.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Upload ảnh ────────────────────────────────────────────────────────────────
# Thư mục lưu file tải lên từ máy (tương đối so với thư mục gốc backend)
UPLOAD_DIR=storage/uploads
# Kích thước tối đa cho 1 file (byte) — 5MB
UPLOAD_MAX_SIZE=5242880
# Đường dẫn public để đọc lại file đã tải lên
UPLOAD_PUBLIC_PATH=/api/uploads
# Nơi lưu ảnh upload:
#   mongo — lưu trong MongoDB (bền vững, BẮT BUỘC trên Render vì disk ephemeral)
#   disk  — chỉ lưu trên đĩa (nhanh hơn, dùng cho dev)
# Bỏ trống = mongo khi production, disk khi dev
# (Không để trống — giá trị rỗng sẽ fail validate và server không start được)
UPLOAD_STORE=disk

# ─── Cache ảnh Wikimedia ─────────────────────────────────────────────────────
# Thư mục cache ảnh tải về từ Wikimedia.
IMAGE_CACHE_DIR=storage/image-cache
# Hạn mức dung lượng cache (byte). Render free plan chỉ có ~1GB disk.
# 0 = không giới hạn.
IMAGE_CACHE_MAX_BYTES=419430400
# Tự tải trước ảnh nền khi server khởi động (Render có disk ephemeral).
#   on  — bật (khuyến nghị cho production)
#   off — tắt
IMAGE_WARMUP=on
# Số ảnh tải đồng thời (tối đa 4)
IMAGE_WARMUP_CONCURRENCY=3
# Trễ trước khi bắt đầu warm up (ms)
IMAGE_WARMUP_DELAY_MS=3000
